# Copy to .env Replace every secret before using beyond local development.
APP_NAME=Knowledge_Digger.io
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_ALGORITHM=
ACCESS_TOKEN_MINUTES=
MAX_UPLOAD_MB=
UPLOAD_DIR=/data/uploads

POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://raguser:REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/ragdb
CHROMA_DB=
CHROMA_COLLECTION=

REDIS_URL=redis://redis:6379/0
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_PREFIX=rag_user

HF_HOME=/models/huggingface
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
GENERATION_MODEL=
RERANKER_MODEL=
ENABLE_RERANKER=false
TOP_K=
MAX_CONTEXT_CHARS=
MAX_ANSWER_TOKENS=
OCR_LANGUAGE=eng
